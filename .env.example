# ============================================
# TOURISM CONTENT GENERATOR - API CONFIGURATION
# ============================================
# Copy this file to .env and fill in your actual API keys

# ============================================
# FACEBOOK SCRAPING
# ============================================
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=facebook-scraper4.p.rapidapi.com

# ============================================
# LLM PROVIDERS
# ============================================
# Anthropic Claude (Primary)
ANTHROPIC_API_KEY=sk-ant-your_key_here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI (Optional)
OPENAI_API_KEY=sk-your_openai_key_here
OPENAI_MODEL=gpt-4-turbo-preview

# Google Gemini (Optional)
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemini-pro

# ============================================
# IMAGE SOURCES
# ============================================
# Pexels (Free: https://www.pexels.com/api/)
PEXELS_API_KEY=your_pexels_key_here

# Unsplash (Free: https://unsplash.com/developers)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# Pixabay (Free: https://pixabay.com/api/docs/)
PIXABAY_API_KEY=your_pixabay_key_here

# Wikimedia - No key needed (always enabled)

# ============================================
# WORDPRESS PUBLISHING (Optional - add later)
# ============================================
WORDPRESS_URL=https://yoursite.com
WORDPRESS_USERNAME=your_username
WORDPRESS_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ============================================
# DATABASE CONFIGURATION
# ============================================
SQLITE_DB_PATH=data/tourism_content.db
CHROMA_DB_PATH=data/chroma_db

# ============================================
# SYSTEM SETTINGS
# ============================================
# Default LLM provider (anthropic, openai, google)
DEFAULT_LLM_PROVIDER=anthropic

# Max posts to scrape per page per run
MAX_POSTS_PER_PAGE=50

# Image download settings
MAX_IMAGES_PER_ARTICLE=10
IMAGE_QUALITY=high

# Scraping schedule (cron format, or leave empty for manual)
SCRAPING_SCHEDULE=

# Content retention (days, 0 = keep forever)
CONTENT_RETENTION_DAYS=0
